# ============================================================
# Exam Nigahban - Git Ignore
# ============================================================

# Environment & Secrets
.env
.env.*
!.env.example
*.secret
*.pem
*.key

# Node.js / React / Vite
node_modules/
dist/
build/
.vite/
coverage/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
*.egg-info/

# AI / Machine Learning
# Scoped to ai/ so this never shadows application source directories that
# happen to share these common names (e.g. backend/app/models/).
*.pt
*.pth
*.onnx
*.weights
*.engine
*.tflite
ai/**/models/
ai/**/model_cache/
ai/**/weights/
# The YOLOX-Nano phone-detection model is a SHIPPED FRONTEND ASSET, not a
# training artifact: the browser fetches it at /models/yolox-nano-phone.onnx
# (see frontend/src/monitoring/objectDetection/constants.js). The *.onnx
# rule above would exclude it, so a fresh clone or a Vercel build would
# produce a frontend whose phone detection 404s at runtime -- silently,
# with no build error. It must be tracked.
!frontend/public/models/
!frontend/public/models/**
.cache/

# Evidence & Runtime Data
evidence/*
!evidence/.gitkeep
uploads/*
!uploads/.gitkeep
runtime/
tmp/
temp/

# Logs
*.log
logs/

# Database / Local Data
*.sqlite
*.sqlite3
*.db
*.sql.bak
database/local/
database/backups/

# Operating System
.DS_Store
Thumbs.db
Desktop.ini
*.lnk

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains
.idea/
*.iml

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Build / Deployment
out/
release/
artifacts/

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
.coverage.*
test-results/
playwright-report/

# Local development
.local/
.local.*
