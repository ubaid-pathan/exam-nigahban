APP_NAME=Exam Nigahban API
APP_VERSION=1.0.0
ENVIRONMENT=production

# Database driver: "mysql" for local development, "postgresql" for Render/Neon
DB_DRIVER=postgresql
DB_HOST=your-neon-hostname.neon.tech
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=exam_nigahban

# Required. Must be a unique, random string of at least 32 characters.
# The application refuses to start if this is left as this placeholder,
# left empty, or shorter than 32 characters. Generate one with e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET

# Comma-separated list of allowed origins
CORS_ORIGINS=https://your-app.vercel.app

# Evidence image storage backend: "local" writes to the filesystem at
# EVIDENCE_STORAGE_ROOT (ephemeral on hosts like Render -- images are lost
# on redeploy, so the API also keeps a base64 copy in the database as a
# fallback), "s3" uploads to durable S3-compatible object storage.
#
# For production use Cloudflare R2 (free tier, zero egress fees):
#   1. Create a bucket in the R2 dashboard (e.g. exam-nigahban-evidence).
#   2. Create an R2 API token with Object Read & Write permission for that
#      bucket; use its Access Key ID / Secret Access Key below.
#   3. Set EVIDENCE_S3_ENDPOINT_URL to the S3 API endpoint shown on the
#      bucket page (https://<account_id>.r2.cloudflarestorage.com).
#   4. After switching EVIDENCE_BACKEND=s3 in the deployed environment, run
#      migrate_evidence_to_s3.py once to upload legacy DB-embedded images.
# For AWS S3 itself, EVIDENCE_S3_ENDPOINT_URL can stay unset; for other
# providers (MinIO, DigitalOcean Spaces, ...) point it at their endpoint.
EVIDENCE_BACKEND=local
EVIDENCE_STORAGE_ROOT=evidence
#EVIDENCE_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
#EVIDENCE_S3_BUCKET=exam-nigahban-evidence
#EVIDENCE_S3_REGION=auto
#EVIDENCE_S3_ACCESS_KEY_ID=
#EVIDENCE_S3_SECRET_ACCESS_KEY=